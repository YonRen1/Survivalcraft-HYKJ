<ClaykilnWidget xmlns="runtime-namespace:Game">
   <BevelledRectangleWidget Size="614, 382" BevelSize="3" />
   
   <!-- 陶土窑标题（保持不变） -->
   <CanvasWidget CanvasWidget.Position="28, 4" Size="144, 72"/>
   
   <!-- 右侧背包标题（保持不变） -->
   <LabelWidget CanvasWidget.Position="286, 24" Text="[ClaykilnWidget:5]" Color="255, 255, 255, 192"/>
   
   <!-- 右侧背包网格（保持不变） -->
   <GridPanelWidget Name="InventoryGrid" CanvasWidget.Position="286, 62" ColumnsCount="4" RowsCount="4"/>
   
   <!-- ===== 左侧工作区 ===== -->
   <!-- 第一行：原料（左） + 燃料（右） -->
   <GridPanelWidget Name="FurnaceGrid" CanvasWidget.Position="70, 90" ColumnsCount="1" RowsCount="1">
      <!-- 原料文字标签-->
      <LabelWidget Text="[ClaykilnWidget:1]" Color="0, 0, 0, 64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </GridPanelWidget>
   <InventorySlotWidget Name="FuelSlot" CanvasWidget.Position="165, 90">
      <LabelWidget Text="[ClaykilnWidget:2]" Color="0, 0, 0, 64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </InventorySlotWidget>
   
   <!-- 第二行：火焰（左） + 进度条（右） -->
   <CanvasWidget CanvasWidget.Position="70, 180">
      <FireWidget Name="Fire" Size="68, 40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <StackPanelWidget Direction="Horizontal">
         <BevelledRectangleWidget Size="24, 44" BevelSize="-2" CenterColor="0, 0, 0, 0" />
         <BevelledRectangleWidget Size="24, 44" BevelSize="-2" CenterColor="0, 0, 0, 0" />
         <BevelledRectangleWidget Size="24, 44" BevelSize="-2" CenterColor="0, 0, 0, 0" />
      </StackPanelWidget>
   </CanvasWidget>
   
   <ValueBarWidget Name="Progress" CanvasWidget.Position="150, 153" LayoutDirection="Vertical" BarsCount="5" FlipDirection="false" LitBarColor="180, 80, 0" UnlitBarColor="0, 0, 0, 150" BarSize="8, 8" BarSubtexture="{Textures/Atlas/ProgressBar}"/>
   
   <!-- 第三行：成品（左） + 副产物（右） -->
   <InventorySlotWidget Name="ResultSlot" CanvasWidget.Position="70, 250" />
   <InventorySlotWidget Name="RemainsSlot" CanvasWidget.Position="165, 250">
      <LabelWidget Text="[ClaykilnWidget:3]" Color="0, 0, 0, 64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </InventorySlotWidget>
   
   <!-- 装饰箭头（路径保持不变）-->
   <ArrowLineWidget Color="0, 0, 0, 96" Width="8" ArrowWidth="0" PointsString="153, 130; 153, 150" AbsoluteCoordinates="true"/>
   <ArrowLineWidget Color="0, 0, 0, 96" Width="8" ArrowWidth="24" PointsString="153, 200; 153, 250" AbsoluteCoordinates="true"/>

   <!-- 原有备用标签（保持不变） -->
   <LabelWidget CanvasWidget.Position="28, 24" Text="[ClaykilnWidget:4]" Color="255, 255, 255, 192"/>
</ClaykilnWidget>